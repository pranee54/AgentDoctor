{
  "name": "@praneeth_54/agentdoctor",
  "version": "3.0.0",
  "description": "Engineering assurance for AI coding agents — repository intelligence, change evidence, safety controls, and MCP tools.",
  "type": "module",
  "bin": {
    "agentdoctor": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/ensure-cli-bin.mjs",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:understanding": "vitest run --config vitest.understanding.config.ts",
    "test:mcp": "vitest run tests/unit/mcp",
    "validate:understanding": "tsx validation/software-understanding/runner/run.ts",
    "validate:mcp-agent": "tsx validation/mcp-agent/run.ts",
    "validate:project-brain": "tsx validation/project-brain/run.ts",
    "validate:project-brain:real-world": "tsx validation/project-brain/real-world-run.ts",
    "benchmark:project-brain": "tsx validation/project-brain/benchmark.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm test",
    "verify:understanding": "npm run typecheck && npm run test:understanding",
    "verify:project-brain": "npm run typecheck && npm run test:understanding && npm run validate:project-brain && npm run benchmark:project-brain",
    "verify:mcp": "npm run typecheck && npm run test:mcp",
    "prepare": "node scripts/ensure-cli-bin.mjs",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "ai",
    "coding-agents",
    "agent-config",
    "cursor",
    "claude-code",
    "codex",
    "copilot",
    "windsurf",
    "gemini",
    "aider",
    "mcp",
    "change-assurance",
    "evidence",
    "engineering-assurance",
    "security",
    "linter",
    "cli",
    "static-analysis",
    "developer-tools"
  ],
  "author": "AgentDoctor Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranee54/AgentDoctor.git"
  },
  "bugs": {
    "url": "https://github.com/pranee54/AgentDoctor/issues"
  },
  "homepage": "https://github.com/pranee54/AgentDoctor#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/pg": "^8.23.1",
    "commander": "^14.0.3",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "picocolors": "^1.1.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "fast-uri": "3.1.8",
    "hono": "4.13.8",
    "qs": "6.16.0"
  }
}
