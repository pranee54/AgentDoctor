{
  "id": "laravel",
  "framework": "Laravel",
  "version": "1.0.0",
  "domains": { "required": ["Payments"], "forbidden": [] },
  "entrypoints": {
    "required": [
      { "framework": "Laravel", "fileSuffix": "routes/web.php" },
      { "framework": "Laravel", "fileSuffix": "artisan" }
    ],
    "forbiddenFrameworks": []
  },
  "dependencies": { "required": [{ "from": "Routes", "to": "Controllers" }], "minCount": 1 },
  "relationships": { "required": [], "minCount": 1 },
  "architectures": { "requiredPatterns": ["DDD"], "forbiddenPatterns": [] },
  "projectModel": { "minDomains": 1, "minEntrypoints": 2, "minDependencies": 1, "minRelationships": 1, "minArchitectures": 1 },
  "query": { "mustFindDomain": "Payments", "minListDomains": 1, "minListEntrypoints": 2 },
  "understand": { "mustContain": ["Repository Overview", "Laravel", "Payments", "Limitations"] }
}
